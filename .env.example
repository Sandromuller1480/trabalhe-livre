# VARIÁVEIS DE AMBIENTE - PLATAFORMA TRABALHE LIVRE
# Renomeie este arquivo para .env.local e preencha com as credenciais reais do seu projeto.

# URL principal da aplicação (ex: http://localhost:3000 em dev ou https://trabalhelivre.com.br em prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credenciais de Acesso ao Supabase
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-do-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-token-anonimo-do-supabase
SUPABASE_SERVICE_ROLE_KEY=seu-token-service-role-privado-do-supabase

# Configurações do Gateway de Pagamento (Mercado Pago, Asaas, Stripe, etc.)
PAYMENT_PROVIDER=simulated
PAYMENT_ACCESS_TOKEN=seu-token-de-acesso-privado-do-gateway
PAYMENT_WEBHOOK_SECRET=sua-chave-secreta-de-validacao-do-webhook
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=sua-chave-publica-do-gateway

# Chave Secreta para tarefas agendadas (Cron Jobs do Vercel/Supabase)
CRON_SECRET=sua-chave-secreta-para-cron-jobs
